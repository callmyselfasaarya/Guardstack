# ==========================================
# Guardstack ASPM Configuration
# ==========================================

# Application Port & Database
PROJECT_NAME=Guardstack
DATABASE_URL=sqlite+aiosqlite:///./guardstack.db
SECRET_KEY=guardstack-secret-key-change-in-production-32bytes

# AI Security Analysis Provider
# Options: 'heuristic' (offline default), 'gemini', 'openai', 'anthropic', 'ollama'
LLM_PROVIDER=heuristic
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# GitHub App Integration (Optional for local simulation)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Threat Feeds
EPSS_API_URL=https://api.first.org/data/v1/epss
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
